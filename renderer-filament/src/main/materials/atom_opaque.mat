material {
    name : KrystalsAtomOpaque,
    shadingModel : lit,
    blending : opaque,
    parameters : [
        { type : float4, name : baseColor },
        { type : float3, name : backgroundColor },
        { type : float2, name : depthRange },
        { type : float, name : depthCueEnabled }
    ]
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 color = materialParams.baseColor;
        // v0.8.33: plain dielectric PBR — no clear coat. Diffuse (baseColor) plus
        // basic Fresnel reflectance (metallic 0 / roughness 0.32 / reflectance 0.56).
        // Lighting (ambient 50% / sun 50%) is provided by the scene's IndirectLight +
        // directional LightManager light.
        // TEMP DEBUG (v0.8.42): customNormal disabled — mesh normals used directly.
        float viewDepth = (getViewFromWorldMatrix() * vec4(getWorldPosition(), 1.0)).z;
        float divisor = max(materialParams.depthRange.x - materialParams.depthRange.y, 0.0001);
        float fog = materialParams.depthCueEnabled * clamp((materialParams.depthRange.x - viewDepth) / divisor, 0.0, 1.0);
        color.rgb = mix(color.rgb, materialParams.backgroundColor, fog);
        material.baseColor = color;
        material.metallic = 0.0;
        // v0.8.33: no clear coat — plain dielectric base with diffuse + basic
        // reflectance (Fresnel) only. Lighting comes from the scene's 50% ambient
        // IndirectLight + 50% sun directional LightManager light.
        material.roughness = 0.55;
        material.reflectance = 0.35;
    }
}
