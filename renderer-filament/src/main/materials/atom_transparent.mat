material {
    name : KrystalsAtomTransparent,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : true,
    doubleSided : true,
    transparency : twoPassesOneSide,
    variables : [ worldNormal ],
    parameters : [
        { type : float4, name : baseColor },
        { type : float3, name : backgroundColor },
        { type : float2, name : depthRange },
        { type : float, name : depthCueEnabled },
        { type : float, name : occupancy },
        { type : float, name : reflectionEnabled },
        { type : float2, name : highlightDirection },
        { type : float, name : highlightIntensity },
        { type : float, name : highlightRadius }
    ]
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 normal = normalize(mat3(getViewFromWorldMatrix()) * variable_worldNormal.xyz);
        float edge = clamp(length(normal.xy), 0.0, 1.0);
        float shade = 1.0 - materialParams.reflectionEnabled * edge * 0.22;
        vec4 color = vec4(materialParams.baseColor.rgb * shade, materialParams.baseColor.a);
        float highlightDistance = distance(normal.xy, materialParams.highlightDirection);
        float highlight = materialParams.reflectionEnabled * materialParams.highlightIntensity *
            (1.0 - smoothstep(0.0, max(materialParams.highlightRadius, 0.001), highlightDistance));
        color.rgb = mix(color.rgb, vec3(1.0), highlight);
        float viewDepth = (getViewFromWorldMatrix() * vec4(getWorldPosition(), 1.0)).z;
        float divisor = max(materialParams.depthRange.x - materialParams.depthRange.y, 0.0001);
        float fog = materialParams.depthCueEnabled * clamp((materialParams.depthRange.x - viewDepth) / divisor, 0.0, 1.0);
        color.rgb = mix(color.rgb, materialParams.backgroundColor, fog);
        float clockwiseFromTwelve = fract(atan(normal.x, normal.y) / 6.28318530 + 1.0);
        color.a *= mix(0.15, 1.0, step(clockwiseFromTwelve, clamp(materialParams.occupancy, 0.0, 1.0)));
        material.baseColor = color;
    }
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.worldNormal = vec4(normalize(getWorldFromModelNormalMatrix() * getPosition().xyz), 0.0);
    }
}
