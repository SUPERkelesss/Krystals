material {
    name : KrystalsAtomSolid,
    shadingModel : lit,
    blending : opaque,
    requires : [ tangents ],
    variables : [ customNormal ],
    parameters : [
        { type : float4, name : baseColor },
        { type : float3, name : backgroundColor },
        { type : float2, name : depthRange },
        { type : float, name : depthCueEnabled },
        { type : float, name : reflectionEnabled },
        { type : float3, name : lightDirection },
        { type : float, name : highlightIntensity },
        { type : float, name : highlightRadius },
        { type : float, name : roughness }
    ]
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 color = materialParams.baseColor;
        // Depth cueing: fade toward the background color with view-space depth.
        float viewDepth = (getViewFromWorldMatrix() * vec4(getWorldPosition(), 1.0)).z;
        float divisor = max(materialParams.depthRange.x - materialParams.depthRange.y, 0.0001);
        float fog = materialParams.depthCueEnabled * clamp((materialParams.depthRange.x - viewDepth) / divisor, 0.0, 1.0);
        color.rgb = mix(color.rgb, materialParams.backgroundColor, fog);
        material.baseColor = color;
        vec3 worldN = normalize(variable_customNormal.xyz);
        vec3 viewN = normalize(mat3(getViewFromWorldMatrix()) * worldN);
        vec3 L = normalize(materialParams.lightDirection);
        vec3 H = normalize(L + vec3(0.0, 0.0, -1.0));
        float NdotL = max(dot(viewN, L), 0.0);
        float spread = clamp((materialParams.highlightRadius - 0.35) / 1.65, 0.0, 1.0);
        float spot = pow(max(dot(viewN, H), 0.0), mix(160.0, 6.0, spread));
        float rim = pow(clamp(1.0 - max(-viewN.z, 0.0), 0.0, 1.0), mix(12.0, 2.5, spread))
            * sqrt(NdotL);
        float highlight = clamp(materialParams.reflectionEnabled * materialParams.highlightIntensity
            * (0.68 * spot + 0.32 * rim) * (1.0 - fog), 0.0, 0.82);
        vec3 atomColor = color.rgb * (0.72 + 0.18 * materialParams.highlightIntensity * NdotL);
        material.baseColor = vec4(0.0, 0.0, 0.0, color.a);
        material.emissive = vec4(mix(atomColor, vec3(0.98), highlight), 0.0);
        // Indirect PBR light preserves element colour and AO. The bounded emissive term
        // above supplies the directional spot and light-side silhouette reflection.
        material.metallic = 0.0;
        material.roughness = materialParams.roughness;
        material.reflectance = 0.45;
        material.clearCoat = 1.0;
        material.clearCoatRoughness = 0.18;
    }
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // The mesh carries normals encoded in the TANGENTS quaternion (no NORMAL
        // attribute is uploaded); decode the sphere's smooth normal here.
        vec4 q = mesh_tangents;
        vec3 n = vec3(
            2.0 * (q.x * q.z + q.w * q.y),
            2.0 * (q.y * q.z - q.w * q.x),
            1.0 - 2.0 * (q.x * q.x + q.y * q.y)
        );
        material.customNormal = vec4(normalize(getWorldFromModelNormalMatrix() * n), 0.0);
    }
}
