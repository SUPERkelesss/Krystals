material {
    name : KrystalsUnlitTransparent,
    shadingModel : unlit,
    blending : transparent,
    doubleSided : true,
    transparency : twoPassesOneSide,
    requires : [ tangents ],
    variables : [ customNormal ],
    parameters : [
        { type : float4, name : baseColor },
        { type : float3, name : backgroundColor },
        { type : float2, name : depthRange },
        { type : float, name : depthCueEnabled },
        { type : float, name : occupancy },
        { type : float, name : reflectionEnabled },
        { type : float3, name : lightDirection },
        { type : float, name : highlightIntensity },
        { type : float, name : highlightRadius }
    ]
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 worldN = normalize(variable_customNormal.xyz);
        vec3 viewN = normalize(mat3(getViewFromWorldMatrix()) * worldN);
        // Edge (silhouette) darkening: view-space normals near the screen plane darken,
        // giving spheres and cylinders stronger volume.
        float edge = clamp(length(viewN.xy), 0.0, 1.0);
        float edgeShade = 1.0 - materialParams.reflectionEnabled * edge * 0.30;
        vec3 L = normalize(materialParams.lightDirection);
        float NdotL = max(dot(viewN, L), 0.0);
        // v0.8.29: light model = ambient 60% + sun 40%.
        float ambientShade = 0.6;
        float sunShade = 0.4 * materialParams.highlightIntensity * NdotL;
        float diffuseShade = ambientShade + sunShade;
        vec4 color = vec4(materialParams.baseColor.rgb * diffuseShade * edgeShade, materialParams.baseColor.a);
        // Real Blinn-Phong specular: half-vector NdotH makes the highlight follow the
        // view (orthographic camera view vector V = (0,0,1)).
        vec3 V = vec3(0.0, 0.0, 1.0);
        vec3 H = normalize(L + V);
        float NdotH = max(dot(viewN, H), 0.0);
        // v0.8.29: sun angular radius drives the highlight width; specular scales with 40%.
        float shininess = max(2.0 / (materialParams.highlightRadius + 0.01), 1.5);
        float specular = materialParams.reflectionEnabled * 0.4 * materialParams.highlightIntensity * pow(NdotH, shininess);
        color.rgb = mix(color.rgb, vec3(1.0), specular * 0.75);
        float viewDepth = (getViewFromWorldMatrix() * vec4(getWorldPosition(), 1.0)).z;
        float divisor = max(materialParams.depthRange.x - materialParams.depthRange.y, 0.0001);
        float fog = materialParams.depthCueEnabled * clamp((materialParams.depthRange.x - viewDepth) / divisor, 0.0, 1.0);
        color.rgb = mix(color.rgb, materialParams.backgroundColor, fog);
        float clockwiseFromTwelve = fract(atan(viewN.x, viewN.y) / 6.28318530 + 1.0);
        color.a *= mix(0.15, 1.0, step(clockwiseFromTwelve, clamp(materialParams.occupancy, 0.0, 1.0)));
        material.baseColor = color;
    }
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        vec4 q = mesh_tangents;
        vec3 n = vec3(
            2.0 * (q.x * q.z + q.w * q.y),
            2.0 * (q.y * q.z - q.w * q.x),
            1.0 - 2.0 * (q.x * q.x + q.y * q.y)
        );
        material.customNormal = vec4(normalize(getWorldFromModelNormalMatrix() * n), 0.0);
    }
}
